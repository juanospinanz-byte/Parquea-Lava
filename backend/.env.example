# =====================================================================
#  Parquea-Lava · Variables de entorno de ejemplo
# =====================================================================
#  Al clonar el repositorio:
#    1. Copia este archivo en la misma carpeta (backend/) con el nombre .env
#         cp .env.example .env
#    2. Cambia los valores por los de TU base de datos MySQL.
#  El archivo .env es privado: no se sube a GitHub (está en .gitignore).
#  Las tablas se crean con el archivo database.sql de la raíz del proyecto.
# =====================================================================

# --- Base de datos MySQL ---
# Dirección del servidor MySQL (localhost si está en tu mismo computador)
DB_HOST=localhost
# Puerto de MySQL (3306 es el de siempre)
DB_PORT=3306
# Usuario y contraseña con los que entras a MySQL
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña
# Nombre de la base de datos creada con database.sql
DB_NAME=parquea_lava

# --- Seguridad ---
# Clave para firmar las sesiones de los usuarios. Usa una larga y difícil de adivinar
# (por ejemplo, el resultado de: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=cambia_esto_por_una_clave_larga_y_secreta

# --- Servidor ---
# Puerto del backend. La app móvil se conecta al 3001 (frontend/src/config.js):
# si lo cambias aquí, cámbialo también allá.
PORT=3001
